#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
sct_pg=""
sct_s3=""
cleanup() {
  if [[ -n "$sct_pg" ]]; then docker rm -f "$sct_pg" >/dev/null; fi
  if [[ -n "$sct_s3" ]]; then docker rm -f "$sct_s3" >/dev/null; fi
}
trap cleanup EXIT
sct_pg="$(docker run --detach --rm -e POSTGRES_PASSWORD=sct-test -e POSTGRES_DB=sct_test -p 127.0.0.1::5432 postgres:17-alpine)"
export SCT_TEST_S3_ACCESS=sct-test-access
export SCT_TEST_S3_SECRET=sct-test-secret
sct_s3="$(docker run --detach --rm -e MINIO_ROOT_USER="$SCT_TEST_S3_ACCESS" -e MINIO_ROOT_PASSWORD="$SCT_TEST_S3_SECRET" -p 127.0.0.1::9000 quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z server /data)"
export SCT_TEST_S3_ENDPOINT="http://$(docker port "$sct_s3" 9000/tcp)"
for attempt in {1..60}; do
  if docker exec "$sct_pg" pg_isready -h 127.0.0.1 -U postgres -d sct_test >/dev/null 2>&1 && curl --silent --fail "$SCT_TEST_S3_ENDPOINT/minio/health/ready" >/dev/null; then break; fi
  sleep 1
done
docker exec "$sct_pg" pg_isready -h 127.0.0.1 -U postgres -d sct_test
export SCT_TEST_DATABASE_URL="postgres://postgres:sct-test@$(docker port "$sct_pg" 5432/tcp)/sct_test"
for bucket in sct-s3one sct-s3two; do
  curl --silent --show-error --fail --aws-sigv4 'aws:amz:us-east-1:s3' --user "$SCT_TEST_S3_ACCESS:$SCT_TEST_S3_SECRET" -X PUT "$SCT_TEST_S3_ENDPOINT/$bucket"
done
cargo test --locked -p sct-server --test transfers -- --ignored --nocapture
