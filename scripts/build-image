#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
sct_context=$(mktemp -d)
trap 'rm -rf "$sct_context"' EXIT
./scripts/prepare-engine-context "$sct_context"
sct_revision=$(cat simple-server.rev)
sct_engine_image="sct-engine:${sct_revision:0:12}"
# This separate image is reusable by other downstream builds. No registry push.
docker build -t "$sct_engine_image" -f "$sct_context/simple-server/crates/engine/Dockerfile" "$sct_context/simple-server"
docker build --build-arg "ENGINE_IMAGE=$sct_engine_image" --build-arg "SIMPLE_SERVER_REV=$sct_revision" -t "${1:-sct-engine-canary:local}" -f Dockerfile "$sct_context"
