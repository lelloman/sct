#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
sct_scale_pg="$(docker run --detach --rm -e POSTGRES_PASSWORD=sct-test -e POSTGRES_DB=sct_test -p 127.0.0.1::5432 postgres:17-alpine)"
trap 'docker rm -f "$sct_scale_pg" >/dev/null' EXIT
for attempt in {1..60}; do
  if docker exec "$sct_scale_pg" pg_isready -h 127.0.0.1 -U postgres -d sct_test >/dev/null 2>&1; then break; fi
  sleep 1
done
export SCT_TEST_DATABASE_URL="postgres://postgres:sct-test@$(docker port "$sct_scale_pg" 5432/tcp)/sct_test"
cargo test --locked -p sct-core --test foundation million_entry_preview -- --ignored --nocapture
