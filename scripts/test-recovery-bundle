#!/usr/bin/env python3
"""Exercise exactly the on-disc bundle in an offline, read-only Linux runtime."""
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[1]
if len(sys.argv) != 2:
    raise SystemExit("Usage: scripts/test-recovery-bundle BUNDLE_DIRECTORY")
bundle = Path(sys.argv[1]).resolve()
manifest = bundle / "recovery/bundle.json"
data = json.loads(manifest.read_bytes())
assert data["platform"] == "linux-x86_64-glibc236"
for item in data["files"]:
    path = bundle / item["path"]
    assert path.stat().st_size == item["length"]
    assert hashlib.sha256(path.read_bytes()).hexdigest() == item["sha256"]
with tempfile.TemporaryDirectory(prefix="sct-recovery-runtime-") as temporary:
    stage = Path(temporary)
    # The exact bundle is copied without alteration to every disc in the fixture.
    for n in range(1, 7):
        disc = stage / f"disc-{n}"
        shutil.copytree(ROOT / f"contracts/fixtures/disc-archive/disc-{n}", disc)
        shutil.copytree(bundle, disc, dirs_exist_ok=True)
        descriptor = json.loads((disc / "disc.json").read_bytes())
        descriptor["bundle_sha256"] = hashlib.sha256(manifest.read_bytes()).hexdigest()
        (disc / "disc.json").write_text(json.dumps(descriptor, sort_keys=True, separators=(",", ":")))
    script = stage / "test.sh"
    script.write_text('''#!/bin/sh
set -eu
cd /work
mkdir -m 700 cache restored final-cache final
# The immutable media is mounted read-only. Copy executable as instructed for noexec mounts.
cp /media/disc-4/recovery/sct-recover /work/recover
chmod +x /work/recover
./recover inspect /media/disc-4 /work/index > /work/inspect.jsonl
./recover verify /media/disc-4 /work/index > /work/verify.jsonl
./recover ingest /media/disc-4 /work/index /work/cache
./recover ingest /media/disc-1 /work/index /work/cache
set +e
./recover restore /work/index /work/cache /work/restored
code=$?
set -e
test "$code" = 2
test ! -e /work/restored/renamed
set +e
./recover restore /work/index /work/cache /work/restored --partial > /work/partial.jsonl
code=$?
set -e
test "$code" = 2
printf ADDDD > /work/expected
cmp /work/expected /work/restored/renamed
test ! -e /work/restored/new
test -d /work/restored/empty
./recover ingest /media/disc-5 /work/index /work/cache
./recover restore /work/index /work/cache /work/restored
printf EEEEE > /work/expected
cmp /work/expected /work/restored/new
# A later point no longer needs disc 1. Its index works entirely from discs 5/6.
./recover ingest /media/disc-6 /work/final-index /work/final-cache
./recover ingest /media/disc-5 /work/final-index /work/final-cache
./recover restore /work/final-index /work/final-cache /work/final
printf FFFFFF > /work/expected
cmp /work/expected /work/final/latest
test ! -e /work/final/renamed
printf 'Packaged offline inspection, verification, complete/degraded/resumed recovery PASS\\n'
''')
    # No shell tools beyond the stock runtime; no compiler, SQLite CLI or Python.
    subprocess.run(["docker", "run", "--rm", "--network", "none", "--read-only",
                    "--user", f"{os.getuid()}:{os.getgid()}", "--cap-drop", "ALL", "--security-opt", "no-new-privileges",
                    "--tmpfs", "/work:rw,exec,mode=1777,size=256m", "--mount", f"type=bind,src={stage},dst=/media,readonly",
                    "debian:bookworm-slim", "sh", "/media/test.sh"], check=True)
