#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
sct_output=${1:?usage: prepare-engine-context EMPTY_OUTPUT_DIRECTORY}
sct_library=${SIMPLE_SERVER_SOURCE:-../simple-server}
sct_revision=$(cat simple-server.rev)
[[ "$sct_revision" =~ ^[0-9a-f]{40}$ ]] || { echo 'invalid simple-server revision' >&2; exit 1; }
if [[ -d "$sct_output" && -n "$(ls -A "$sct_output")" ]]; then
  echo 'output directory must be empty' >&2; exit 1
fi
mkdir -p "$sct_output/sct" "$sct_output/simple-server"
# Export the reviewed library commit, never local edits or credentials.
git -C "$sct_library" archive "$sct_revision" | tar -xf - -C "$sct_output/simple-server"
tar --exclude='web/node_modules' --exclude='web/dist' --exclude='web/test-results' --exclude='web/playwright-report' --exclude='__pycache__' -cf - Cargo.toml Cargo.lock rust-toolchain.toml README.md .gitignore Dockerfile simple-server.rev config.example.toml config.local.example.toml crates web scripts tests examples contracts docs | tar -xf - -C "$sct_output/sct"
printf '%s\n' "$sct_revision" > "$sct_output/simple-server-source-revision"
