{
  "name": "sct-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "check": "prettier --check . && eslint . && vue-tsc --noEmit",
    "format": "prettier --write .",
    "test:e2e": "../scripts/test-e2e",
    "test:acceptance": "SCT_FULL_ACCEPTANCE=1 ../scripts/test-e2e",
    "test:contracts": "node --test contracts/fixtures.test.ts"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "ajv": "^8.20.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
